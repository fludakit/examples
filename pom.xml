<?xml version="1.0" encoding="UTF-8"?>
<project xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xmlns="http://maven.apache.org/POM/4.0.0"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>com.example</groupId>
    <artifactId>fluda-examples-parent</artifactId>
    <version>1.0.0-SNAPSHOT</version>
    <packaging>pom</packaging>

    <name>FluDa :: Examples</name>
    <description>Runnable examples for the fluent JDBC client.</description>
    <url>https://github.com/fludakit/examples</url>

    <licenses>
        <license>
            <name>The Apache License, Version 2.0</name>
            <url>https://www.apache.org/licenses/LICENSE-2.0.txt</url>
        </license>
    </licenses>

    <developers>
        <developer>
            <name>Hantsy Bai</name>
            <email>hantsy@gmail.com</email>
        </developer>
    </developers>

    <scm>
        <connection>scm:git:git://github.com/fludakit/examples.git</connection>
        <developerConnection>scm:git:ssh://github.com/fludakit/examples.git</developerConnection>
        <url>https://github.com/fludakit/examples</url>
        <tag>HEAD</tag>
    </scm>

    <modules>
        <module>vanilla</module>
        <module>javase</module>
        <module>servlet</module>
        <module>jakartaee</module>
        <module>sql-init-standalone</module>
    </modules>

    <properties>
        <fluda-jdbc-client.version>1.0.0-SNAPSHOT</fluda-jdbc-client.version>
        <fluda-sql-init.version>1.0.0-SNAPSHOT</fluda-sql-init.version>
        <fluda-tx.version>1.0.0-SNAPSHOT</fluda-tx.version>

        <!-- Global Config -->
        <maven.compiler.release>21</maven.compiler.release>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>

        <!-- Examples are not published to Maven Central. -->
        <maven.deploy.skip>true</maven.deploy.skip>

        <!-- Maven Plugins -->
        <maven-compiler-plugin.version>3.16.0</maven-compiler-plugin.version>
        <maven-surefire-plugin.version>3.6.0</maven-surefire-plugin.version>
        <maven-failsafe-plugin.version>3.6.0</maven-failsafe-plugin.version>
        <maven-dependency-plugin.version>3.11.0</maven-dependency-plugin.version>
        <maven-war-plugin.version>3.5.1</maven-war-plugin.version>

        <!-- Jakarta EE / MicroProfile -->
        <jakartaee-api.version>11.0.0</jakartaee-api.version>
        <microprofile.version>7.1</microprofile.version>

        <!-- Testing -->
        <junit.version>6.1.3</junit.version>
        <h2.version>2.5.250</h2.version>
        <postgresql.version>42.7.13</postgresql.version>
        <weld-junit5.version>5.0.3.Final</weld-junit5.version>
        <smallrye-config.version>4.0.0</smallrye-config.version>
        <hikaricp.version>7.1.0</hikaricp.version>

        <!-- Servlet container and CDI -->
        <tomcat.version>11.0.26</tomcat.version>
        <weld.version>6.0.4.Final</weld.version>

        <!-- Databases -->
        <mariadb.version>3.5.10</mariadb.version>

        <!-- Arquillian -->
        <arquillian-bom.version>1.10.2.Final</arquillian-bom.version>
        <arquillian-jakarta-bom.version>10.0.0.Final</arquillian-jakarta-bom.version>
        <shrinkwrap-resolver-bom.version>3.3.7</shrinkwrap-resolver-bom.version>
        <arquillian-glassfish.version>7.0.14</arquillian-glassfish.version>
        <arquillian-tomcat.version>1.2.5.Final</arquillian-tomcat.version>
        <glassfish.version>8.0.4</glassfish.version>
        <wildfly.version>41.0.0.Final</wildfly.version>
        <wildfly-arquillian.version>6.0.0.Alpha1</wildfly-arquillian.version>

        <!-- Tooling -->
        <cargo-maven3-plugin.version>1.10.29</cargo-maven3-plugin.version>
        <wildfly-maven-plugin.version>6.0.1.Final</wildfly-maven-plugin.version>
    </properties>

    <dependencyManagement>
        <dependencies>
            <!-- FluDa JDBC Client modules -->
            <dependency>
                <groupId>io.github.fludakit</groupId>
                <artifactId>fluda-jdbc-client-core</artifactId>
                <version>${fluda-jdbc-client.version}</version>
            </dependency>
            <dependency>
                <groupId>io.github.fludakit</groupId>
                <artifactId>fluda-jdbc-client-config</artifactId>
                <version>${fluda-jdbc-client.version}</version>
            </dependency>
            <dependency>
                <groupId>io.github.fludakit</groupId>
                <artifactId>fluda-jdbc-client-cdi</artifactId>
                <version>${fluda-jdbc-client.version}</version>
            </dependency>

            <!-- FluDa TX modules -->
            <dependency>
                <groupId>io.github.fludakit</groupId>
                <artifactId>fluda-tx-core</artifactId>
                <version>${fluda-tx.version}</version>
            </dependency>
            <dependency>
                <groupId>io.github.fludakit</groupId>
                <artifactId>fluda-tx-cdi</artifactId>
                <version>${fluda-tx.version}</version>
            </dependency>
            <dependency>
                <groupId>io.github.fludakit</groupId>
                <artifactId>fluda-tx-jdbc</artifactId>
                <version>${fluda-tx.version}</version>
            </dependency>

            <!-- FluDa SQL Init modules -->
            <dependency>
                <groupId>io.github.fludakit</groupId>
                <artifactId>fluda-sql-init-core</artifactId>
                <version>${fluda-sql-init.version}</version>
            </dependency>
            <dependency>
                <groupId>io.github.fludakit</groupId>
                <artifactId>fluda-sql-init-config</artifactId>
                <version>${fluda-sql-init.version}</version>
            </dependency>
            <dependency>
                <groupId>io.github.fludakit</groupId>
                <artifactId>fluda-sql-init-cdi</artifactId>
                <version>${fluda-sql-init.version}</version>
            </dependency>

            <!-- BOMs -->
            <dependency>
                <groupId>org.jboss.arquillian</groupId>
                <artifactId>arquillian-bom</artifactId>
                <version>${arquillian-bom.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
            <dependency>
                <groupId>org.jboss.arquillian.jakarta</groupId>
                <artifactId>arquillian-jakarta-bom</artifactId>
                <version>${arquillian-jakarta-bom.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
            <dependency>
                <groupId>org.jboss.shrinkwrap.resolver</groupId>
                <artifactId>shrinkwrap-resolver-bom</artifactId>
                <version>${shrinkwrap-resolver-bom.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
            <dependency>
                <groupId>org.junit</groupId>
                <artifactId>junit-bom</artifactId>
                <version>${junit.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>

            <!-- Jakarta EE API -->
            <dependency>
                <groupId>jakarta.platform</groupId>
                <artifactId>jakarta.jakartaee-bom</artifactId>
                <version>${jakartaee-api.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
            <dependency>
                <groupId>jakarta.platform</groupId>
                <artifactId>jakarta.jakartaee-api</artifactId>
                <version>${jakartaee-api.version}</version>
            </dependency>

            <dependency>
                <groupId>org.eclipse.microprofile</groupId>
                <artifactId>microprofile</artifactId>
                <version>${microprofile.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>

            <!-- Databases -->
            <dependency>
                <groupId>com.h2database</groupId>
                <artifactId>h2</artifactId>
                <version>${h2.version}</version>
            </dependency>
            <dependency>
                <groupId>org.postgresql</groupId>
                <artifactId>postgresql</artifactId>
                <version>${postgresql.version}</version>
            </dependency>
            <dependency>
                <groupId>org.mariadb.jdbc</groupId>
                <artifactId>mariadb-java-client</artifactId>
                <version>${mariadb.version}</version>
            </dependency>

            <!-- CDI (Weld) -->
            <dependency>
                <groupId>org.jboss.weld.se</groupId>
                <artifactId>weld-se-core</artifactId>
                <version>${weld.version}</version>
            </dependency>
            <dependency>
                <groupId>org.jboss.weld.servlet</groupId>
                <artifactId>weld-servlet-core</artifactId>
                <version>${weld.version}</version>
            </dependency>
            <dependency>
                <groupId>org.jboss.weld</groupId>
                <artifactId>weld-junit5</artifactId>
                <version>${weld-junit5.version}</version>
            </dependency>
            <dependency>
                <groupId>io.smallrye.config</groupId>
                <artifactId>smallrye-config</artifactId>
                <version>${smallrye-config.version}</version>
            </dependency>
            <dependency>
                <groupId>com.zaxxer</groupId>
                <artifactId>HikariCP</artifactId>
                <version>${hikaricp.version}</version>
            </dependency>

            <!-- Tomcat -->
            <dependency>
                <groupId>org.apache.tomcat.embed</groupId>
                <artifactId>tomcat-embed-core</artifactId>
                <version>${tomcat.version}</version>
            </dependency>
            <dependency>
                <groupId>org.apache.tomcat.embed</groupId>
                <artifactId>tomcat-embed-jasper</artifactId>
                <version>${tomcat.version}</version>
            </dependency>
            <dependency>
                <groupId>org.apache.tomcat.embed</groupId>
                <artifactId>tomcat-embed-websocket</artifactId>
                <version>${tomcat.version}</version>
            </dependency>
            <dependency>
                <groupId>org.apache.tomcat</groupId>
                <artifactId>tomcat</artifactId>
                <version>${tomcat.version}</version>
            </dependency>
            <dependency>
                <groupId>org.apache.tomcat</groupId>
                <artifactId>tomcat-dbcp</artifactId>
                <version>${tomcat.version}</version>
            </dependency>

            <!-- Arquillian containers -->
            <dependency>
                <groupId>org.jboss.arquillian.container</groupId>
                <artifactId>arquillian-tomcat-embedded-10</artifactId>
                <version>${arquillian-tomcat.version}</version>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <build>
        <pluginManagement>
            <plugins>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-compiler-plugin</artifactId>
                    <version>${maven-compiler-plugin.version}</version>
                </plugin>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-surefire-plugin</artifactId>
                    <version>${maven-surefire-plugin.version}</version>
                </plugin>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-failsafe-plugin</artifactId>
                    <version>${maven-failsafe-plugin.version}</version>
                </plugin>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-dependency-plugin</artifactId>
                    <version>${maven-dependency-plugin.version}</version>
                </plugin>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-war-plugin</artifactId>
                    <version>${maven-war-plugin.version}</version>
                </plugin>
                <plugin>
                    <groupId>org.codehaus.cargo</groupId>
                    <artifactId>cargo-maven3-plugin</artifactId>
                    <version>${cargo-maven3-plugin.version}</version>
                </plugin>
                <plugin>
                    <groupId>org.wildfly.plugins</groupId>
                    <artifactId>wildfly-maven-plugin</artifactId>
                    <version>${wildfly-maven-plugin.version}</version>
                </plugin>
                <plugin>
                    <groupId>io.github.mavenplugins</groupId>
                    <artifactId>central-publishing-maven-plugin</artifactId>
                    <configuration>
                        <skipBundling>true</skipBundling>
                        <skipPublishing>true</skipPublishing>
                    </configuration>
                </plugin>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-deploy-plugin</artifactId>
                    <configuration>
                        <skip>true</skip>
                    </configuration>
                </plugin>
            </plugins>
        </pluginManagement>
    </build>

    <repositories>
        <repository>
            <name>GitHub Packages - Fludakit Org</name>
            <id>github-fludakit</id>
            <url>https://maven.pkg.github.com/fludakit/*</url>
            <releases>
                <enabled>false</enabled>
            </releases>
            <snapshots>
                <enabled>true</enabled>
            </snapshots>
        </repository>
        <repository>
            <name>Central Portal Snapshots</name>
            <id>central-portal-snapshots</id>
            <url>https://central.sonatype.com/repository/maven-snapshots/</url>
            <releases>
                <enabled>false</enabled>
            </releases>
            <snapshots>
                <enabled>true</enabled>
            </snapshots>
        </repository>
    </repositories>
</project>
